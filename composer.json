{
    "name": "solarjuice/partner-api",
    "description": "PHP client for the Solar Juice Partner API: catalogue, inventory, specials, shipping quotes and orders.",
    "version": "1.0.0",
    "type": "library",
    "keywords": ["solarjuice", "solar", "partner-api", "api-client", "ecommerce"],
    "homepage": "https://dev.solarjuice.com.au",
    "license": "MIT",
    "support": {
        "docs": "https://dev.solarjuice.com.au/docs",
        "email": "developers@solarjuice.com.au"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "SolarJuice\\PartnerApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SolarJuice\\PartnerApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "check": ["@lint", "@test"]
    },
    "config": {
        "sort-packages": true
    }
}
